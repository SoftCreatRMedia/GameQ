{
  "name": "softcreatr/gameq",
  "type": "library",
  "description": "A maintained PHP game-server status query library based on GameQ by Austinb",
  "license": "LGPL-3.0-or-later",
  "keywords": [
    "gameq",
    "game server",
    "query",
    "server status"
  ],
  "authors": [
    {
      "name": "Austin Bischoff",
      "email": "austin.bischoff@gmail.com",
      "homepage": "https://github.com/Austinb",
      "role": "Packagist/Composer Maintainer, Developer"
    },
    {
