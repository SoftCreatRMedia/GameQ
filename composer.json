      "email": "info@softcreatr.dev",
      "homepage": "https://softcreatr.dev",
      "role": "Fork Maintainer, Developer"
    },
    {
      "name": "Krymo Software",
      "email": "info@krymo.software",
      "homepage": "https://krymo.software",
      "role": "Fork Maintainer, Developer"
    },
    {
      "name": "Christoph Kretzschmar",
      "email": "blackskyliner@googlemail.com",
      "homepage": "https://github.com/Blackskyliner",
      "role": "Developer"
    },
    {
      "name": "Marcel Bößendörfer",
      "email": "m.boessendoerfer@marbis.net",
      "homepage": "https://github.com/nitrado",
      "role": "Developer"
    },
    {
      "name": "Alexander Hambalgo",
      "homepage": "http://balgo.users.sourceforge.net/",
      "role": "Developer"
    },
    {
      "name": "Holger",
      "homepage": "http://icet33.users.sourceforge.net/",
      "role": "Developer"
    },
    {
      "name": "Sebastian Weidenbach",
      "homepage": "http://sebastianwe.users.sourceforge.net/",
      "role": "Developer"
    },
    {
      "name": "Patrick Henninger",
      "email": "privat@skyraptor.eu",
      "homepage": "https://skyraptor.eu",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/SoftCreatRMedia/GameQ/issues",
    "wiki": "https://github.com/SoftCreatRMedia/GameQ/wiki",
    "source": "https://github.com/SoftCreatRMedia/GameQ"
  },
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*",
    "ext-xml": "*"
  },
  "suggest": {
    "ext-bz2": "Required to decode compressed Source/A2S split responses."
  },
  "require-dev": {
    "corneltek/getoptionkit": "^2.7",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.1",
    "roave/backward-compatibility-check": "^8.1",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "GameQ\\": "src/GameQ/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GameQ\\Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "bc-check": "roave-backward-compatibility-check --from=5.0.0 --to=HEAD",
    "lint": "parallel-lint --colors src tests examples",
    "phpcbf": "phpcbf --standard=build/config/phpcs.xml",
    "phpcs": "phpcs --standard=build/config/phpcs.xml",
    "phpstan": "phpstan analyse --no-progress",
    "phpunit": "vendor/bin/phpunit",
    "test": [
      "@lint",
      "@phpcs",
      "@phpstan",
      "@phpunit"
    ]
  },
  "scripts-descriptions": {
    "bc-check": "Check the public API for backwards-incompatible changes since 5.0.0",
    "lint": "Check all PHP files for syntax errors",
    "phpcbf": "Automatically fix coding-standard violations",
    "phpcs": "Run PHP Code Style checks",
    "phpstan": "Run PHPStan checks",
    "phpunit": "Run PHPUnit tests",
    "test": "Run all tests and checks"
  }
}
